    },
    {
      "id": "69c6e145",
      "kapitel_titel": "Kapitel 28: Neun Sekunden",
      "satz": "»Die Dienstanweisung«, sagte er zu niemandem im Besonderen, »kennt nur den Flur.«",
      "frage": "nicht witzig genug",
      "datum": "2026-11-13 17:13"
    },
    {
      "id": "443bfbef",
      "kapitel_titel": "Kapitel 28: Neun Sekunden",
      "satz": "»Plus vierzehn. Minus drei.",
      "frage": "Realistische zahlen?",
      "datum": "2026-11-13 17:16"
    },
    {
      "id": "0547148e",
      "kapitel_titel": "Kapitel 28: Neun Sekunden",
      "satz": "»Ich weiß, dass jeder *weiter* sagt, der etwas noch einmal hören will. Heute Nacht hab ich es trotzdem gehört.«",
      "frage": "vin",
      "datum": "2026-11-13 17:17"
    },
    {
      "id": "9f968e03",
      "kapitel_titel": "Kapitel 28: Neun Sekunden",
      "satz": "Sie zählte nicht. Es kam einfach, als hätte es seit Freitag mit am Tisch gesessen und darauf gewartet, dass ihm jemand die Butter reicht.",
      "frage": "vin",
      "datum": "2026-11-13 17:18"
    },
    {
      "id": "5604194e",
      "kapitel_titel": "Kapitel 28: Neun Sekunden",
      "satz": "»Das war schnell«, sagte er.",
      "frage": "Was",
      "datum": "2026-11-13 17:19"
    },
    {
      "id": "6a040e2a",
      "kapitel_titel": "Kapitel 28: Neun Sekunden",
      "satz": "»Ich weiß. Ich hab nachgesehen.« Er überlegte, ob er die Zahl sagen sollte, und sagte sie dann. »Achtmal.«",
      "frage": "vin",
      "datum": "2026-11-13 17:19"
    },
    {
      "id": "20e900be",
      "kapitel_titel": "Kapitel 28: Neun Sekunden",
      "satz": "»Ich dich auch«, sagte sie.",
      "frage": "vin",
      "datum": "2026-11-13 17:19"
    },
    {
      "id": "22274d7c",
      "kapitel_titel": "Kapitel 28: Neun Sekunden",
