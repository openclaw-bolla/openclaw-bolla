<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Bolla Jobs</title>
<style>
:root{--bg:#f5f6f8;--card:#fff;--tx:#1b1f24;--mut:#5b6572;--bd:#dde1e7;--ok:#1a7f37;--warn:#b42318;--run:#0b63c5;--act:#a15c00;--soon:#5b6572}
@media (prefers-color-scheme:dark){:root{--bg:#14171b;--card:#1d2127;--tx:#eceff3;--mut:#9aa5b1;--bd:#2c323a;--ok:#4cc26d;--warn:#ff7b72;--run:#58a6ff;--act:#e3b341;--soon:#9aa5b1}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font:18px/1.45 system-ui,-apple-system,Segoe UI,sans-serif}
main{max-width:760px;margin:0 auto;padding:16px}
h1{font-size:26px;margin:4px 0 2px}
.sub{color:var(--mut);font-size:16px;margin-bottom:12px}
h2{font-size:20px;margin:22px 0 8px}
.row{background:var(--card);border:1px solid var(--bd);border-left:6px solid var(--soon);border-radius:10px;padding:12px 14px;margin:8px 0}
.row.ok{border-left-color:var(--ok)}.row.fehler{border-left-color:var(--warn)}.row.laeuft{border-left-color:var(--run)}.row.aktion{border-left-color:var(--act)}
.t{font-weight:600}.d{color:var(--mut);font-size:16px;margin-top:2px}
.w{font-size:16px;color:var(--mut);white-space:nowrap}
.top{display:flex;justify-content:space-between;gap:10px;align-items:baseline}
a{color:var(--run)}
.empty{color:var(--mut);padding:6px 2px}
button{font:inherit;padding:8px 14px;border-radius:8px;border:1px solid var(--bd);background:var(--card);color:var(--tx)}
</style>
</head>
<body>
<main>
<h1>🐾 Bolla Jobs</h1>
<div class="sub"><span id="stand">lädt…</span> · <button onclick="load()">Aktualisieren</button></div>
<div id="out"></div>
</main>
<script>
const ICON={laeuft:"🔄",ok:"✅",fehler:"⚠️",aktion:"👉"};
const esc=s=>String(s==null?"":s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
function fmt(iso){
  const d=new Date(iso),n=new Date();
  const day=d.toDateString()===n.toDateString()?"heute":
    d.toDateString()===new Date(n.getTime()+864e5).toDateString()?"morgen":
    d.toDateString()===new Date(n.getTime()-864e5).toDateString()?"gestern":
    d.toLocaleDateString("de-DE",{weekday:"short",day:"2-digit",month:"2-digit"});
  return day+" "+d.toLocaleTimeString("de-DE",{hour:"2-digit",minute:"2-digit"});
}
function jobRow(j){
  const link=j.link?` · <a href="${esc(j.link)}" target="_blank" rel="noopener">Details</a>`:"";
  return `<div class="row ${esc(j.status)}"><div class="top"><span class="t">${ICON[j.status]||"•"} ${esc(j.title)}</span><span class="w">${fmt(j.ts)}</span></div>${j.detail?`<div class="d">${esc(j.detail)}${link}</div>`:""}</div>`;
}
function section(title,items,emptyText){
  return `<h2>${title}</h2>`+(items.length?items.join(""):`<div class="empty">${emptyText}</div>`);
}
async function load(){
  try{
    const r=await fetch("/api/jobs",{cache:"no-store"});const d=await r.json();
    const J=d.jobs||[];
    const attn=J.filter(j=>j.status==="fehler"||j.status==="aktion");
    const run=J.filter(j=>j.status==="laeuft");
    const done=J.filter(j=>j.status==="ok").slice(0,15);
    const up=(d.upcoming||[]).map(u=>`<div class="row"><div class="top"><span class="t">⏳ ${esc(u.title)}</span><span class="w">${fmt(u.when)}</span></div></div>`);
    document.getElementById("out").innerHTML=
      section("Braucht dich",attn.map(jobRow),"Nichts – alles ruhig 👌")+
      section("Läuft gerade",run.map(jobRow),"Nichts läuft.")+
      section("Steht an",up,"Nichts Geplantes in den nächsten 14 Tagen.")+
      section("Zuletzt erledigt",done.map(jobRow),"Noch nichts eingetragen.");
    document.getElementById("stand").textContent="Stand "+fmt(d.now);
  }catch(e){document.getElementById("stand").textContent="Server nicht erreichbar";}
}
load();setInterval(load,30000);
</script>
</body>
</html>
